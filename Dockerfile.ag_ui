FROM python:3.11-slim

WORKDIR /app

COPY requirements-ag-ui.txt .
RUN pip install --no-cache-dir -r requirements-ag-ui.txt

COPY utils/ ./utils/
COPY agent/ ./agent/
COPY ag_ui_adapter/ ./ag_ui_adapter/

RUN mkdir -p /app/logs

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 8010

CMD ["uvicorn", "ag_ui_adapter.main:app", "--host", "0.0.0.0", "--port", "8010"]
