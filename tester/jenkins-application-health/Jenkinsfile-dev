pipeline {
  agent none

  parameters {
    base64File(name: 'TC_TASK_FILE_LOCAL', description: 'Upload the application health test Excel file')
    hidden(name: 'LLM_API_URL', defaultValue: 'https://api.llm.nstcloud.ru/v1', description: 'LLM API URL')
    choice(
      choices: ['Qwen/Qwen3-30B-A3B', 'openai/gpt-oss-20b'],
      name: 'LLM_API_MODEL',
      description: 'LLM model name'
    )
    hidden(name: 'ADK_API_BASE', defaultValue: 'chatbot-dev', description: 'Google ADK Agent environment')
    string(name: 'ADK_TIMEOUT_SEC', defaultValue: '180', description: 'Optional ADK API timeout in seconds (default: 180 seconds)')
    string(
      name: 'HEALTH_CHECK_EMAIL_TO',
      defaultValue: 'it@nstdata.ru',
      description: 'Comma-separated recipients for health-check email notifications'
    )
  }

  triggers {
    cron('H */4 * * *')
  }

  options {
    skipDefaultCheckout(true)
  }

  stages {
    stage('Run application health tester') {
      agent {
        kubernetes {
          yaml """
            apiVersion: v1
            kind: Pod
            metadata:
              labels:
                app: application-health-tester
            spec:
              restartPolicy: Never
              imagePullPolicy: IfNotPresent
              containers:
                - name: application-health-tester
                  # image: cr.yandex/crp4m4ne3bkrq9l2ffbi/aszh-chatbot/adk-agent-tester:v0.7-amd64
                  image: cr.yandex/crp4m4ne3bkrq9l2ffbi/aszh-chatbot/adk-agent-tester@sha256:f6657628056be206ae6a4ec22b52c96edb2711f8c25f58850ad2925457e0ef7b
                  command:
                    - cat
                  tty: true
            """
          defaultContainer 'application-health-tester'
        }
      }

      environment {
        ADK_API_BASE = "http://adk-agent.${params.ADK_API_BASE}:8000"
        ADK_ENV_NAME = "${params.ADK_API_BASE}"
        ADK_APP_NAME = "agent"
        ADK_TEST_FIRST_NAME = "Jenkins"
        ADK_TIMEOUT_SEC = "${params.ADK_TIMEOUT_SEC}"
        LLM_API_URL = "${params.LLM_API_URL}"
        LLM_API_MODEL = "${params.LLM_API_MODEL}"
        TC_TASK_FILE_LOCAL = "${params.TC_TASK_FILE_LOCAL}"
        TELEGRAM_PROXY = "socks5://10.1.1.12:1080"
      }

      steps {
        withCredentials([
          string(credentialsId: 'LLM_API_KEY_GOOGLE_ADK_AGENT', variable: 'LLM_API_KEY')
        ]) {
          container('application-health-tester') {
            sh '''
              set -euo pipefail
              was_x=0
              case "$-" in
                *x*) was_x=1 ;;
              esac
              set +x
              excel_file="/app/ping_nstya_bot.xlsx"
              if [ -n "${TC_TASK_FILE_LOCAL:-}" ] && [ "${TC_TASK_FILE_LOCAL}" != "null" ]; then
                excel_file="/app/${TC_TASK_FILE_LOCAL_FILENAME}"
                printf "%s" "${TC_TASK_FILE_LOCAL}" | base64 -d > "$excel_file"
                echo "Using uploaded file: $excel_file"
              else
                echo "Using scheduled health-check file: $excel_file"
              fi
              if [ "$was_x" -eq 1 ]; then
                set -x
              fi
              set +e
              python3 /app/application_health_tester.py --excel "$excel_file" --out /app
              tester_status=$?
              set -e
              mkdir -p "${WORKSPACE}/tester"
              for f in /app/HEALTH_CHECK_REPORT_*.xlsx /app/HEALTH_CHECK_ALERT.txt; do
                if [ -e "$f" ]; then
                  cp -v "$f" "${WORKSPACE}/tester/"
                fi
              done
              exit "$tester_status"
            '''
          }
        }
      }

      post {
        always {
          archiveArtifacts artifacts: 'tester/HEALTH_CHECK_REPORT_*.xlsx, tester/HEALTH_CHECK_ALERT.txt', allowEmptyArchive: true
        }
        success {
          script {
            def recipients = params.HEALTH_CHECK_EMAIL_TO?.trim()
            if (!recipients) {
              echo 'Skipping email: HEALTH_CHECK_EMAIL_TO is empty.'
            } else {
              mail(
                to: recipients,
                subject: "[JENKINS] ${env.JOB_NAME} #${env.BUILD_NUMBER} - Application health report",
                mimeType: 'text/html',
                body: """Build ${env.JOB_NAME} #${env.BUILD_NUMBER} completed successfully.<br/>
                         Build URL: ${env.BUILD_URL}<br/>
                         ADK_API_BASE: ${env.ADK_API_BASE}<br/><br/>
                         Download report: <a href="${env.BUILD_URL}artifact/tester/">${env.BUILD_URL}artifact/tester/</a>"""
              )
            }
          }
        }
        failure {
          script {
            if (fileExists('tester/HEALTH_CHECK_ALERT.txt')) {
              def recipients = params.HEALTH_CHECK_EMAIL_TO?.trim()
              if (recipients) {
                mail(
                  to: recipients,
                  subject: "[ALERT] chatbot-${env.ADK_ENV_NAME} is malfunctioning",
                  mimeType: 'text/plain',
                  body: """Application health check detected trigger matches.

${readFile('tester/HEALTH_CHECK_ALERT.txt')}

Build URL: ${env.BUILD_URL}
ADK_API_BASE: ${env.ADK_API_BASE}
Download report: ${env.BUILD_URL}artifact/tester/
"""
                )
              } else {
                echo 'Skipping alert email: HEALTH_CHECK_EMAIL_TO is empty.'
              }
              withCredentials([
                string(credentialsId: 'TELEGRAM_ALERT_BOT_TOKEN', variable: 'TELEGRAM_BOT_TOKEN'),
                string(credentialsId: 'TELEGRAM_ALERT_CHAT_ID', variable: 'TELEGRAM_CHAT_ID'),
              ]) {
                container('application-health-tester') {
                  sh '''
                    python3 /app/send_health_alert_telegram.py \
                      --alert-file "${WORKSPACE}/tester/HEALTH_CHECK_ALERT.txt" \
                      --env-name "${ADK_ENV_NAME}" \
                      --build-url "${BUILD_URL}" \
                      --adk-api-base "${ADK_API_BASE}" \
                      || echo "WARNING: failed to send Telegram alert"
                  '''
                }
              }
            }
          }
        }
      }
    }
  }
}
