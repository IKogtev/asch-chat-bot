FROM python:3.11-slim

WORKDIR /app

# Копируем pip.conf для ускорения установки
COPY pip.conf /etc/pip.conf
COPY requirements-agent.txt .
RUN pip install --no-cache-dir -r requirements-agent.txt

# Копируем utils для логирования
COPY utils/ ./utils/

# Копируем только необходимые файлы из agent/, исключая кэш
COPY agent/*.py ./agent/
COPY agent/agents/*.py ./agent/agents/

# Кастомный FastAPI-обёрток для adk api_server, добавляет /mcp-healthz.
COPY app_server.py ./app_server.py

# Создаём директорию для логов
RUN mkdir -p /app/logs

ENV PYTHONPATH=/app

CMD ["python", "-m", "uvicorn", "app_server:app", "--host", "0.0.0.0", "--port", "8000"]